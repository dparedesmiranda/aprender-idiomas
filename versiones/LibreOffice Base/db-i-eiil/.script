SET DATABASE COLLATION "Spanish"
CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE CACHED TABLE "Letra"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"Representacion" CHAR(5) NOT NULL)
CREATE CACHED TABLE "Silaba"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"Silaba" VARCHAR(100))
CREATE CACHED TABLE "TipoSilaba"("Id" INTEGER NOT NULL PRIMARY KEY,"Nombre" VARCHAR(100) NOT NULL,"Descripcion" VARCHAR(100))
CREATE CACHED TABLE "Palabra"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"Palabra" VARCHAR(20))
CREATE CACHED TABLE "PalabraSilabas"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"PalabraId" INTEGER NOT NULL,"SilabaId" INTEGER NOT NULL)
CREATE CACHED TABLE "Idioma"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"Idioma" VARCHAR(30) NOT NULL)
CREATE CACHED TABLE "Alfabeto"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"IdiomaId" INTEGER NOT NULL,"LetraId" INTEGER NOT NULL,"TipoLetraRepresentacionId" INTEGER NOT NULL,"TipoLetraAlfabetoId" INTEGER NOT NULL)
CREATE CACHED TABLE "TipoLetraAlfabeto"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"Nombre" VARCHAR(30) NOT NULL,"Descripcion" VARCHAR(100))
CREATE CACHED TABLE "SilabaLetras"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"SilabaId" INTEGER NOT NULL,"LetraId" INTEGER NOT NULL)
CREATE CACHED TABLE "TipoPalabra"("Id" INTEGER NOT NULL PRIMARY KEY,"Nombre" VARCHAR(100) NOT NULL,"Descripcion" VARCHAR(100))
CREATE CACHED TABLE "SilabaIdioma"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"SilabaId" INTEGER NOT NULL,"IdiomaId" INTEGER NOT NULL,"TipoSilabaId" INTEGER NOT NULL)
CREATE CACHED TABLE "Vocabulario"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"PalabraId" INTEGER NOT NULL,"IdiomaId" INTEGER NOT NULL,"TipoPalabraId" INTEGER NOT NULL)
CREATE CACHED TABLE "PalabraLetras"("Id" INTEGER NOT NULL PRIMARY KEY,"LetraId" INTEGER)
CREATE CACHED TABLE "TipoLetraRepresentacion"("Id" INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,"Nombre" VARCHAR(30) NOT NULL,"Descripcion" VARCHAR(100))
SET TABLE "Letra" INDEX'1272 76'
SET TABLE "Silaba" INDEX'2624472 117945'
SET TABLE "Idioma" INDEX'4720912 4'
SET TABLE "Alfabeto" INDEX'4723248 90'
SET TABLE "TipoLetraAlfabeto" INDEX'4725440 4'
SET TABLE "TipoLetraRepresentacion" INDEX'4725832 2'
ALTER TABLE "Letra" ALTER COLUMN "Id" RESTART WITH 76
ALTER TABLE "Silaba" ALTER COLUMN "Id" RESTART WITH 117945
ALTER TABLE "Palabra" ALTER COLUMN "Id" RESTART WITH 0
ALTER TABLE "PalabraSilabas" ALTER COLUMN "Id" RESTART WITH 0
ALTER TABLE "Idioma" ALTER COLUMN "Id" RESTART WITH 4
ALTER TABLE "Alfabeto" ALTER COLUMN "Id" RESTART WITH 90
ALTER TABLE "TipoLetraAlfabeto" ALTER COLUMN "Id" RESTART WITH 4
ALTER TABLE "SilabaLetras" ALTER COLUMN "Id" RESTART WITH 0
ALTER TABLE "SilabaIdioma" ALTER COLUMN "Id" RESTART WITH 0
ALTER TABLE "Vocabulario" ALTER COLUMN "Id" RESTART WITH 0
ALTER TABLE "TipoLetraRepresentacion" ALTER COLUMN "Id" RESTART WITH 2
CREATE USER SA PASSWORD ""
GRANT DBA TO SA
SET WRITE_DELAY 60
